[Unit]
Description=Hearth API server
Documentation=https://github.com/dopatraman/hearth
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/hearth
ExecStart=/opt/hearth/bin/hearth
Restart=on-failure
RestartSec=5s

Environment=SQLITE_PATH=/opt/hearth/data/hearth.db
Environment=HEARTH_ADDR=127.0.0.1:8080
Environment=APPLE_AUDIENCE=com.dopatraman.hearth
# SESSION_SECRET and anything else sensitive comes from .env (not in git).
EnvironmentFile=/opt/hearth/.env
# APNs env (optional; written by the deploy workflow when APNS_* secrets are set).
EnvironmentFile=-/opt/hearth/apns.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/hearth/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
